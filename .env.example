# Copy to .env and fill in. Only `nu build.nu --deploy` reads these; a plain build needs neither.

# Name of the Cloudflare Pages project to publish to. It is created on first deploy.
# The site is served at <name>.pages.dev unless that address is already taken.
WAYFINDER_PAGES_PROJECT=my-event-wayfinder

# Only needed when your wrangler login can reach more than one Cloudflare account.
CLOUDFLARE_ACCOUNT_ID=
